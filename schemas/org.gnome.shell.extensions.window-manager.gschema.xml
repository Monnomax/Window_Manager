<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.window-manager">
        <key name="window-states" type="s">
            <default>'{}'</default>
            <summary>Saved window positions and sizes</summary>
        </key>
        <key name="restore-position" type="b">
            <default>true</default>
            <summary>Restore window positions</summary>
        </key>
        <key name="restore-size" type="b">
            <default>true</default>
            <summary>Restore window sizes</summary>
        </key>
        <key name="excluded-apps" type="as">
            <default>[]</default>
            <summary>Applications excluded from window state tracking</summary>
        </key>

        <key name="show-minimize" type="b">
            <default>true</default>
            <summary>Показувати кнопку "Згорнути"</summary>
        </key>
        <key name="show-maximize" type="b">
            <default>true</default>
            <summary>Показувати кнопку "Розгорнути"</summary>
        </key>
        <key name="show-close" type="b">
            <default>true</default>
            <summary>Показувати кнопку "Закрити"</summary>
        </key>
        <key name="button-position" type="s">
            <choices>
                <choice value="left" />
                <choice value="right" />
            </choices>
            <default>"right"</default>
            <summary>Розташування кнопок керування вікном</summary>
        </key>
        <key name="original-button-layout" type="s">
            <default>""</default>
            <summary>Збережене початкове значення button-layout</summary>
        </key>
        <key name="has-original-button-layout" type="b">
            <default>false</default>
            <summary>Чи було збережено початкове значення button-layout</summary>
        </key>

        <key name="height" type="i">
            <default>2</default>
            <summary>Height of the scroll area</summary>
        </key>
        <key name="width-percent" type="i">
            <default>100</default>
            <summary>Width of the scroll area in percent</summary>
        </key>
        <key name="show-indicator" type="b">
            <default>false</default>
            <summary>Show white indicator bar</summary>
        </key>
    </schema>
</schemalist>